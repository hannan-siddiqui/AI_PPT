# =================================================================
# AI PRESENTATION GENERATOR - END-TO-END PIPELINE CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# AGENT 1: IMAGE UNDERSTANDING & OCR AGENT (Kimi-k3 Vision)
# -----------------------------------------------------------------
VISION_MODEL=moonshotai/kimi-k3
VISION_BASE_URL=https://integrate.api.nvidia.com/v1
VISION_API_KEY=your-vision-api-key-here

# -----------------------------------------------------------------
# AGENT 2: DATA READING & INSTRUCTION UNDERSTANDING AGENT
# -----------------------------------------------------------------
REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
REASONING_BASE_URL=https://integrate.api.nvidia.com/v1
REASONING_API_KEY=your-reasoning-api-key-here

# -----------------------------------------------------------------
# AGENT 3: SLIDE DECK ARCHITECT AGENT (PPT CREATION)
# -----------------------------------------------------------------
ARCHITECT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
ARCHITECT_BASE_URL=https://integrate.api.nvidia.com/v1
ARCHITECT_API_KEY=your-architect-api-key-here

# -----------------------------------------------------------------
# STAGE 5: VLM-AS-JUDGE (QUALITY ASSURANCE)
# -----------------------------------------------------------------
ENABLE_VLM_JUDGE=true
JUDGE_MODEL=moonshotai/kimi-k3
JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
JUDGE_API_KEY=your-judge-api-key-here

# -----------------------------------------------------------------
# SERVER & STORAGE CONFIGURATION
# -----------------------------------------------------------------
PORT=5000
STORAGE_PROVIDER=local
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
MAX_CONCURRENT_JOBS=4
